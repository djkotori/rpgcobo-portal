
import VirtualKeyCode;
import FileDialogMode;
import AccountState;

//	ファイルのダウンロード、キャッシュ

local url2fn( url){
	local i0 = url.lastIndexOf( "/"), i1 = url.lastIndexOf( "/", i0-1)+1;
	return url.substring( i1).replace( "/", "-");
}

local cacheres(){
	local r = getResource( "/portalcache");
	if( !r){
		local dir = FileRef( skGetCacheDir()+"/portalcache");
		r = createResource( dir);
		::resroot.list .. r;
		r.pres = ::resroot;
	}
	return r;
}

//	
function getMediaFile( url){
	if( url[0]=='/'){	//	/から始まる場合はリソースからの相対ファイル
		return resroot.getResource( url).file;
	}else{
		//	キャッシュの場所
		local dir = FileRef( skGetCacheDir()+"/portalcache");
		return FileRef( dir, url2fn( url));
	}
}

function getMediaResource( url){
	if( url[0]=='/'){
		return resroot.getResource( url);
	}else{
		return cacheres().getResource( url2fn( url));
	}
}

function downloadMedia( url, cachetime=0){
	if( url.contains( "$")) url = ~( compiletemplate( url), {HOME=::homeenv.url_home});
	//
	if( url[0]=='/') return resroot.getResource( url);
	local f = getMediaFile( url);
	if( f.exists()){
		if( cachetime){
			local dt = Date().currentTime() - f.lastmodified;
			if( dt[0] < cachetime) return getMediaResource( url);
		}else{
			return getMediaResource( url);
		}
	}
	try{
		local dir = FileRef( skGetCacheDir()+"/portalcache");
		dir.mkdirs();
		local tmpf = FileRef( f.path+".dl");	//	テンポラリにダウンロードしてからリネーム
		local http = HTTPClient();
		local dlf = http.request( url, "GET", null, HTTPFileReceiver( tmpf));
		printf( "downloadMedia url=%S  file=%S %S statuscode=%S\n", url, dlf["path"], dlf?.exists(), http["statuscode"]);
		if( f.exists()){ f.deleteFile(); suspend(); } //	ちょっと待たないとたまに失敗する～
		tmpf.moveTo( f);
		local dir = cacheres();
		local r = FileResource( f, dir);
		dir.list .. r;
		return r;
	}catch( ex){
		//	もしダウンロード失敗してもキャッシュが残ってたらそれを返す
		if( f.exists()) return getMediaResource( url);
		throw ex;
	}
}

//	PreferenceDialogが動くようにメソッドだけ入れとく
if( !::["skstudio"]) ::skstudio <- {
