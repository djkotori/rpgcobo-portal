//	MarkdownHomeContentで追加するやつ。日付、タイトル名、リンクボタン。
//	
class SKMarkdownHeader extends SKMarkdownNode
{
	marginu = 4;
	margind = 8;
	
	function makeFontAttribute(){
		return FontAttribute( Fonts.get( "ui"), 18, 0xffffffff, SK_FONT_BOLD);
	}
}

//	MarkdownHomeContentで追加するやつ。日付、タイトル名、リンクボタン。
//	
class SKMarkdownTitle extends SKMarkdownNode
{
	function setup( t){
		ast = t;
	}

	function setWidth( w){
		stretchSize( w, bnd.h, true);
	}
}

//	MarkdownHomeContentで追加するやつ。日付、タイトル名、リンクボタン。
//	
class SKMarkdownTitleLink extends SKMarkdownNode
{
	function setup( t){
		ast = t;
	}

	function setWidth( w){
		stretchSize( w, bnd.h, true);
	}
}
